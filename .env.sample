# Test the whole admin without a database: cp .env.sample .env.local
# Data comes from data/sample.json and resets whenever the dev server restarts.
# Sign in at /admin with the password below. Never deploy with these values.
USE_SAMPLE_DATA=1
ADMIN_PASSWORD="admin"
SESSION_SECRET="sample-only-not-a-real-secret"
# Optional: enables the AI assistant while testing
ANTHROPIC_API_KEY=""
