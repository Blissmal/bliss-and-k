DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
ADMIN_PASSWORD="choose-a-long-passphrase"
# openssl rand -hex 32
SESSION_SECRET=""
# openssl rand -base64 32  (encrypts API keys at rest; losing it makes stored keys unrecoverable)
KEY_ENCRYPTION_SECRET=""
# Email reminders (Resend). REMINDER_FROM must be on a domain verified in Resend.
RESEND_API_KEY=""
REMINDER_FROM="Bliss & K <reminders@yourdomain.com>"
ADMIN_EMAIL=""
# openssl rand -hex 32  (the scheduler sends this as a Bearer token)
CRON_SECRET=""
# AI assistant (Claude API). AI_MODEL is optional and defaults to claude-sonnet-5.
ANTHROPIC_API_KEY=""
